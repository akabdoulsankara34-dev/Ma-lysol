{
  "entities": {
    "businesses": {
      "title": "Business",
      "description": "PME or store profile registered in BizPilot Burkina",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Commercial name of the store" },
        "accessCode": { "type": "string", "description": "Unique enterprise access code e.g. BF-SONG-2026" },
        "ownerId": { "type": "string", "description": "User ID of the owner" },
        "ownerName": { "type": "string", "description": "Name of the business owner" },
        "phone": { "type": "string", "description": "Store contact phone" },
        "city": { "type": "string", "description": "City e.g. Ouagadougou, Bobo-Dioulasso" },
        "sector": { "type": "string", "description": "Business activity sector" },
        "ifu": { "type": "string", "description": "IFU tax number if available" },
        "currency": { "type": "string", "description": "Default currency e.g. FCFA" },
        "receiptFooter": { "type": "string", "description": "Custom message on receipts" },
        "status": { "type": "string", "description": "active or suspended" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "accessCode", "ownerId", "currency"]
    },
    "products": {
      "title": "Product",
      "description": "Stock inventory and sales item",
      "type": "object",
      "properties": {
        "businessId": { "type": "string" },
        "name": { "type": "string" },
        "sku": { "type": "string" },
        "category": { "type": "string" },
        "unit": { "type": "string" },
        "purchasePrice": { "type": "number" },
        "salePrice": { "type": "number" },
        "currentStock": { "type": "number" },
        "alertThreshold": { "type": "number" },
        "supplier": { "type": "string" },
        "archived": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["businessId", "name", "salePrice", "currentStock"]
    },
    "sales": {
      "title": "Sale",
      "description": "Completed or credit point-of-sale transaction",
      "type": "object",
      "properties": {
        "businessId": { "type": "string" },
        "receiptNumber": { "type": "string" },
        "sellerId": { "type": "string" },
        "sellerName": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "total": { "type": "number" },
        "totalCost": { "type": "number" },
        "profit": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "paymentBreakdown": { "type": "object" },
        "status": { "type": "string" },
        "cancelledAt": { "type": "string", "format": "date-time" },
        "cancelledBy": { "type": "string" },
        "cancelledByName": { "type": "string" },
        "cancellationReason": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["businessId", "receiptNumber", "total", "paymentMethod", "items"]
    },
    "stock_movements": {
      "title": "StockMovement",
      "description": "Detailed log of every inventory addition, deduction, or loss",
      "type": "object",
      "properties": {
        "businessId": { "type": "string" },
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "type": { "type": "string" },
        "quantity": { "type": "number" },
        "previousStock": { "type": "number" },
        "newStock": { "type": "number" },
        "reason": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["businessId", "productId", "type", "quantity"]
    },
    "customers": {
      "title": "Customer",
      "description": "Customer record with debt/credit tracking",
      "type": "object",
      "properties": {
        "businessId": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "totalDebt": { "type": "number" },
        "dueDate": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["businessId", "name", "phone"]
    },
    "customer_payments": {
      "title": "CustomerPayment",
      "description": "Reimbursement of credit/debt by a customer",
      "type": "object",
      "properties": {
        "businessId": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "amount": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "recordedBy": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["businessId", "customerId", "amount", "paymentMethod"]
    },
    "expenses": {
      "title": "Expense",
      "description": "Store operational expenses",
      "type": "object",
      "properties": {
        "businessId": { "type": "string" },
        "category": { "type": "string" },
        "amount": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "beneficiary": { "type": "string" },
        "recordedBy": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["businessId", "category", "amount", "paymentMethod"]
    },
    "users": {
      "title": "User",
      "description": "User profile and permissions",
      "type": "object",
      "properties": {
        "businessId": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "role": { "type": "string" },
        "pin": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "phone", "role"]
    },
    "avoirs": {
      "title": "Avoir",
      "description": "Reconnaissance de dette / avoir monnaie émis pour un client",
      "type": "object",
      "properties": {
        "numero": { "type": "string", "description": "Numéro auto-incrémenté format AV-0001" },
        "commerceId": { "type": "string", "description": "Identifiant du commerce" },
        "businessId": { "type": "string", "description": "Identifiant entreprise BizPilot" },
        "venteId": { "type": "string", "description": "Référence vente d'origine" },
        "venteReceiptNumber": { "type": "string" },
        "clientNom": { "type": "string" },
        "clientTel": { "type": "string" },
        "montant": { "type": "number" },
        "dateCreation": { "type": "string", "format": "date-time" },
        "statut": { "type": "string", "enum": ["actif", "utilise", "rembourse"] },
        "venteUtilisationId": { "type": "string" },
        "venteUtilisationReceiptNumber": { "type": "string" },
        "dateUtilisation": { "type": "string", "format": "date-time" },
        "dateRemboursement": { "type": "string", "format": "date-time" },
        "caissierId": { "type": "string" },
        "caissierNom": { "type": "string" },
        "rembourseParId": { "type": "string" },
        "rembourseParNom": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["numero", "montant", "statut", "dateCreation"]
    },
    "apps": {
      "title": "DigiSoliaApp",
      "description": "Registered product in the DigiSolia App Framework ecosystem",
      "type": "object",
      "properties": {
        "appId": { "type": "string" },
        "name": { "type": "string" },
        "shortName": { "type": "string" },
        "description": { "type": "string" },
        "version": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "maintenance", "beta"] },
        "category": { "type": "string" },
        "usersCount": { "type": "number" },
        "lastUpdatedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["appId", "name", "version", "status"]
    },
    "apps/{appId}/feedback": {
      "title": "DigiSoliaFeedback",
      "description": "User rating, comment, suggestion, bug report, or complaint scoped by appId",
      "type": "object",
      "properties": {
        "appId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "category": { "type": "string", "enum": ["avis", "suggestion", "bug", "reclamation"] },
        "rating": { "type": "number" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["en_attente", "en_cours", "resolu", "rejete"] },
        "adminResponse": { "type": "string" },
        "reviewedBy": { "type": "string" },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "clientFingerprint": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["appId", "userId", "category", "message", "status", "createdAt"]
    },
    "apps/{appId}/support": {
      "title": "DigiSoliaSupportTicket",
      "description": "Technical assistance or support request scoped by appId",
      "type": "object",
      "properties": {
        "appId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "issueType": { "type": "string", "enum": ["assistance", "technique", "compte", "facturation", "autre"] },
        "priority": { "type": "string", "enum": ["normale", "urgente"] },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "appVersion": { "type": "string" },
        "status": { "type": "string", "enum": ["en_attente", "en_cours", "resolu", "rejete"] },
        "adminResponse": { "type": "string" },
        "assignedTo": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["appId", "userId", "issueType", "subject", "message", "status", "createdAt"]
    },
    "administrators": {
      "title": "DigiSoliaAdministrator",
      "description": "Centralized DigiSolia Admin accounts with RBAC roles",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["super_admin", "app_admin", "support_agent", "stats_reader"] },
        "assignedApps": { "type": "array" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "role", "active"]
    },
    "notifications": {
      "title": "DigiSoliaNotification",
      "description": "Broadcast notifications across DigiSolia applications",
      "type": "object",
      "properties": {
        "appId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["info", "warning", "success", "urgent"] },
        "targetAudience": { "type": "string", "enum": ["all", "admins", "owners"] },
        "createdBy": { "type": "string" },
        "createdByName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["appId", "title", "message", "type", "createdAt"]
    },
    "admin_logs": {
      "title": "DigiSoliaAdminLog",
      "description": "Immutable audit log of administrative actions",
      "type": "object",
      "properties": {
        "actorId": { "type": "string" },
        "actorName": { "type": "string" },
        "actorRole": { "type": "string" },
        "action": { "type": "string" },
        "targetType": { "type": "string" },
        "targetId": { "type": "string" },
        "details": { "type": "string" },
        "appId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["actorId", "actorName", "actorRole", "action", "targetType", "targetId", "createdAt"]
    }
  }
}
